# All optional. The server prints which integrations are on at startup.
PORT=3000

# Grok voice (xAI)
XAI_API_KEY=
XAI_VOICE_MODEL=grok-voice-latest
XAI_VOICE=eve

# Capital One Nessie (https://api.nessieisreal.com)
NESSIE_API_KEY=

# Database location (default: data/stride.db). On a cloud host, point this at a persistent disk.
DATABASE_PATH=

# Push notifications: keys are generated automatically; set a contact for push services.
VAPID_SUBJECT=mailto:you@example.com

# iMessage run recaps (macOS host only). Users add their phone number in Wallet.
IMESSAGE_ENABLED=0

# Challenges: simulated runs count toward challenges unless NODE_ENV=production.
# Set to 1 to always allow (e.g. a live demo), 0 to never allow.
ALLOW_SIM_CHALLENGES=
